# Snowflake Connection
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_PATH=~/.ssh/snowflake_rsa_key.p8
SNOWFLAKE_ROLE=CORTEX_AI_ADMIN
SNOWFLAKE_WAREHOUSE=CORTEX_AI_INGESTION_WH
SNOWFLAKE_DATABASE=CORTEX_AI_PLATFORM
SNOWFLAKE_SCHEMA=RAW

# Environment
ENVIRONMENT=dev
LOG_LEVEL=INFO
